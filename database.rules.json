{
  "rules": {
    "menu": {
      ".read": true,
      ".write": "auth != null",
      "$id": {
        ".validate": "!newData.exists() || newData.hasChildren(['name', 'price'])",
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "price": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$otro": { ".validate": false }
      }
    },

    "pedidos": {
      ".read": "auth != null",
      "$id": {
        ".write": "!data.exists() || auth != null",
        ".validate": "!newData.exists() || newData.hasChildren(['name', 'price', 'cantidad', 'total'])",
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "productoId": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "price": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "cantidad": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 99 && newData.val() % 1 === 0" },
        "total": { ".validate": "newData.isNumber() && newData.val() === newData.parent().child('price').val() * newData.parent().child('cantidad').val()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$otro": { ".validate": false }
      }
    }
  }
}
