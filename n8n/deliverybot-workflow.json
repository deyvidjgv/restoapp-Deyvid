      "name": "Redactar mensaje de estado",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [-320, 1140],
      "parameters": {
        "functionCode": "const ETIQUETAS = { PENDING: 'Recibido', IN_PREPARATION: 'En preparación', ON_THE_WAY: 'En camino', DELIVERED: 'Entregado' };\nconst destino = $('Webhook - /pedidos/:id/avanzar (POST)').item.json.body.estado_destino;\nconst pedido = $('PEDIDOS - Leer el pedido a avanzar').item.json;\nreturn [{ json: {\n  telegram_id: pedido.id_usuario,\n  texto: '📦 Tu pedido ' + pedido.id_pedido + ' ahora está: ' + (ETIQUETAS[destino] || destino) + (destino === 'ON_THE_WAY' ? ' 🚴' : destino === 'DELIVERED' ? ' ✅' : '')\n}}];"
      }
    },
