    {
      "id": "fn-calcular-reporte",
      "name": "Calcular métricas del día",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [-760, 1500],
      "parameters": {
        "functionCode": "const hoy = new Date().toISOString().slice(0, 10);\nconst pedidosHoy = items.map(i => i.json).filter(p => p.fecha === hoy);\n\nconst totalVendido = pedidosHoy.reduce((s, p) => s + Number(p.total_pago || 0), 0);\n\nconst conteoProductos = {};\nconst conteoHoras = {};\nfor (const p of pedidosHoy) {\n  let detalle = [];\n  try { detalle = JSON.parse(p.detalles_pedido || '[]'); } catch (e) {}\n  for (const item of detalle) {\n    conteoProductos[item.nombre] = (conteoProductos[item.nombre] || 0) + Number(item.cantidad || 0);\n  }\n  const hora = String(p.hora || '00:00:00').slice(0, 2);\n  conteoHoras[hora] = (conteoHoras[hora] || 0) + 1;\n}\n\nfunction top(obj) {\n  const entradas = Object.entries(obj);\n  if (!entradas.length) return null;\n  return entradas.sort((a, b) => b[1] - a[1])[0][0];\n}\n\nreturn [{ json: {\n  fecha: hoy,\n  total_pedidos: pedidosHoy.length,\n  total_vendido: totalVendido,\n  producto_estrella: top(conteoProductos) || 'Sin datos',\n  hora_pico: top(conteoHoras) ? (top(conteoHoras) + ':00') : 'Sin datos'\n}}];"
      },
      "notes": "Inteligencia de Negocio: total vendido, producto estrella y hora pico, calculados directo de PEDIDOS."
    },
    {
      "id": "sheets-guardar-reporte",
      "name": "REPORTES - Guardar métricas del día",
